extends SceneTree
const E=preload("res://scripts/economy.gd")
const C=preload("res://scripts/delivery_chapter_v3.gd")
const U=preload("res://scripts/delivery_rift_risk_ui_v1.gd")
const W=preload("res://scripts/workshop_parts_v2.gd")
var passed:int=0
var failed:int=0
func check(ok:bool,label:String):
 if ok:passed+=1;print("PASS ",label)
 else:failed+=1;push_error("FAIL "+label)
func same(a,b)->bool:return JSON.parse_string(JSON.stringify(a))==JSON.parse_string(JSON.stringify(b))
func _initialize():
 var path:String=OS.get_environment("SC_NATIVE_SEED")
 var bytes:PackedByteArray=FileAccess.get_file_as_bytes(path)
 var raw:Dictionary=JSON.parse_string(bytes.get_string_from_utf8())
 var file=FileAccess.open("user://savegame.json",FileAccess.WRITE);file.store_buffer(bytes);file.close()
 var e=E.new();e.load_state();e.enable_story_mode()
 check(not e.review_load_blocked and e.day==5 and e.delivery_chapter_status().complete,"genuine completed day5 loads")
 var old=e.contracts.duplicate(true);e.ensure_contracts();check(same(old,e.contracts),"displayed old day5 exact")
 check(e.close_day_and_save(raw.design,raw.launcher,raw.settings).ok,"ordinary close")
 check(e.next_day_and_save(raw.design,raw.launcher,raw.settings).ok,"ordinary next day")
 var r:Dictionary=e.contracts[0]
 check(e.day==6 and r.get("rift_delivery_layout")==C.COLD_REPEAT_ID,"normal day6 A new challenge")
 check(r.reward==660 and r.required==80 and not r.chapter_progression,"frozen reward threshold repeat")
 check(r.distance==240 and same(r.rift_biology.cold_bounds,[110,-30,100,60]),"frozen geometry")
 check(C.route_error(r).is_empty() and e.route_preflight_error(r).is_empty(),"real preflight valid")
 check(U.preview(r).receiver==Vector2(240,0) and U.preview(r).cold_bounds==Rect2(110,-30,100,60),"map actual geometry")
 check(U.guidance(r).contains("保温") and U.guidance(r).contains("暖区"),"two choices visible guidance")
 check(C.fresh_route(5).distance==200 and not C.fresh_route(5).has("rift_delivery_layout"),"mainline unchanged")
 check(C.fresh_route(5,false,false,false,true).size()>0,"optional factory")
 check(C.fresh_route(5,true,false,false,true).is_empty() and C.fresh_route(1,false,false,false,true).is_empty() and C.fresh_route(5,false,true,false,true).is_empty(),"illegal authoring combinations rejected")
 var frozen=r.duplicate(true);e.ensure_contracts();check(same(frozen,e.contracts[0]),"shown quote frozen")
 check(e.accept_contract_and_save(r.contract_id,raw.design,raw.launcher,raw.settings).ok,"normal accept")
 check(e.mark_cargo_loaded(r.contract_id).ok,"normal cargo load")
 var accepted=e.active_contract().duplicate(true);e.ensure_contracts();check(same(accepted,e.active_contract()),"accepted quote frozen")
 check(e.save_state(raw.design,raw.launcher,raw.settings),"accepted saves")
 var resumed=E.new();resumed.load_state();resumed.enable_story_mode()
 check(not resumed.review_load_blocked and same(accepted,resumed.active_contract()),"accepted reload")
 check(resumed.begin_dispatch(raw.design,raw.launcher,raw.settings.launch_settings).ok,"normal dispatch")
 check(resumed.save_state(raw.design,raw.launcher,raw.settings),"inflight save")
 var flying=resumed.in_flight.duplicate(true);var loaded=E.new();loaded.load_state();loaded.enable_story_mode()
 check(not loaded.review_load_blocked and same(flying,loaded.in_flight),"inflight reload exact")
 check(FileAccess.get_file_as_bytes(path)==bytes,"source native save unchanged")
 # Isolated authoring boundary fixtures; no injected player economy is flown.
 var boundary=E.new();boundary.load_state();boundary.in_flight={};boundary.contracts=[];boundary.day=8;boundary.ensure_contracts()
 check(boundary.contracts.size()==2 and boundary.contracts[0].distance==200 and not boundary.contracts[0].has("rift_delivery_layout"),"alternate day8 original rift")
 boundary.contracts=[];boundary.day=10;boundary.credits=-1;boundary.ensure_contracts()
 check(boundary.contracts.size()==2 and boundary.contracts[0].chapter_level==1,"debt retains recovery")
 print("DEV45_CHECK passed=%d failed=%d"%[passed,failed]);quit(0 if failed==0 else 1)
