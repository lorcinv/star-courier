extends SceneTree
## Actual router + world + native Control integration using synthesized inputs.
const Investigation=preload("res://scripts/shop_investigation.gd")
const EXACT:String="一颗微缩黑洞，易碎，千万不要弄摔着了，可能会导致一些严重的小问题。"
var game
var input
var passed:int=0
var failed:int=0
var underlying_clicks:int=0
func _initialize() -> void:run.call_deferred()
func check(ok:bool,label:String) -> void:
 if ok:passed+=1;print("PASS ",label)
 else:failed+=1;push_error("FAIL "+label)
func settle(frames:int=2) -> void:
 for unused in frames:await process_frame
func key(code:int,down:bool=true,echo:bool=false) -> void:
 var event:=InputEventKey.new();event.keycode=code;event.physical_keycode=code;event.pressed=down;event.echo=echo;Input.parse_input_event(event);await settle(1)
func button(code:int,down:bool=true,device:int=0) -> void:
 var event:=InputEventJoypadButton.new();event.device=device;event.button_index=code;event.pressed=down;Input.parse_input_event(event);await settle(1)
func axis(value:float,device:int=0) -> void:
 var event:=InputEventJoypadMotion.new();event.device=device;event.axis=JOY_AXIS_LEFT_X;event.axis_value=value;Input.parse_input_event(event);await settle(1)
func mouse(point:Vector2,down:bool) -> void:
 var event:=InputEventMouseButton.new();event.position=point;event.global_position=point;event.button_index=MOUSE_BUTTON_LEFT;event.pressed=down;Input.parse_input_event(event);await settle(1)
func tick(seconds:float=.016) -> void:input.tick(seconds)
func step(seconds:float) -> void:
 for unused in ceili(seconds*120):tick(1.0/120.0);game.world._process(1.0/120.0)
func at_marble() -> void:
 game.navigate("hub");game.world.clerk.position=Vector2(Investigation.STATION_X,496);game.world._adopt_shop_clerk();game.world.set_shop_input(0,true);tick(0)
func rig_pose() -> Dictionary:
 var parts:Array=[]
 for node in game.world._clerk_motion._parts.values():parts.append([str(node.name),node.transform,str(node.texture.resource_path),node.visible])
 return {"root":game.world.clerk.transform,"z":game.world.clerk.z_index,"rig":game.world._clerk_motion._rig.visible,"parts":parts,"facing":game.world._clerk_motion.debug_snapshot().facing_right}
func state() -> String:
 return JSON.stringify({"credits":game.economy.credits,"day":game.economy.day,"phase":game.economy.phase,"inventory":game.economy.inventory,"contracts":game.economy.contracts,"active":game.economy.active_contract_id,"research":game.economy.research,"reviews":game.economy.review_state,"story":game.economy.story_state,"design":game.design,"launcher":game.launcher})
func run() -> void:
 for file in ["savegame.json","savegame.backup.json","savegame.tmp"]:
  if FileAccess.file_exists("user://"+file):DirAccess.remove_absolute("user://"+file)
 game=load("res://scenes/main.tscn").instantiate();root.add_child(game);game.set_process(false);await settle(4)
 game.world.set_process(false);game.world.assembly_feedback.set_process(false);input=game.courier_input;tick()
 check(Investigation.QUOTE==EXACT,"exact supplied Chinese quotation is byte-for-byte unchanged")
 check(not game.investigation.is_open() and input.context=="shop","fresh game has no forced examination or tutorial")
 check(game.world.shop_interaction().id=="focus_counter","home counter interaction remains authoritative")
 game._action(Investigation.ACTION,null);check(not game.investigation.is_open(),"direct remote action cannot examine outside proximity")
 var original_state:String=state();var parcel_id:int=game.world.parcel.get_instance_id();var generation:int=game.world._parcel_generation
 var prop:Sprite2D=game.world.foreground_root.get_node("StoredBlackMarble")
 check(prop.texture.get_size()==Vector2(36,30) and prop.scale==Vector2.ONE,"modest 36 by 30 sprite renders at one-to-one scale")
 check(prop.position+Vector2(0,15)==Investigation.PROP_BOTTOM and prop.get_child_count()==0,"registered bottom anchor adds no collider or gameplay node")
 check(prop.position.distance_to(game.world.parcel.position)>64,"prop is separate from real customer parcel anchor")
 await key(KEY_D)
 for unused in 360:
  step(1.0/120.0)
  if str(game.world.shop_interaction().get("id",""))==Investigation.ACTION:break
 await key(KEY_D,false);step(.22)
 check(str(game.world.shop_interaction().get("id",""))==Investigation.ACTION,"actual walking route reaches local examination station")
 tick();check(input._hint.text=="E 查看黑色弹珠","only nearby keyboard prompt identifies optional object")
 await key(KEY_E);tick()
 check(game.investigation.is_open() and input.context=="investigation","fresh E opens native examination context")
 check(game.investigation._body.text==EXACT,"native label contains the complete quote")
 check(root.gui_get_focus_owner()==game.investigation._close,"native focus begins on the sole close action")
 check(not game.world._shop_input_enabled and input.shop_axis()==0,"opening immediately freezes shop input")
 await key(KEY_E,true,true);await key(KEY_E);check(game.investigation.is_open(),"opening E echo and duplicate held press do not close panel")
 var frozen:Dictionary=rig_pose();var feet:Vector2=game.world.clerk.position;await key(KEY_D);step(.3)
 check(rig_pose()==frozen,"inspection freezes exact rendered rig transforms textures root depth and facing")
 check(game.world._clerk_motion.debug_snapshot().rigid_active and str(game.world._clerk_motion.debug_snapshot().pose) not in ["align","ready","farewell"],"inspection preserves the rigid empty-hand representation without fake tablet or wave")
 var owner:int=game.investigation._owner
 game.world.release_investigation(owner+1)
 check(game.world.investigation_owned_by(owner),"foreign owner cannot release inspection")
 game._action("customer_reviews",null)
 check(not game._open_review_phone() and not game._review_phone_is_open() and not game.world.acquire_review_phone(999),"phone cannot steal open inspection through action main or world")
 game.rotate_part();game.remove_part();game.undo_assembly();game.start_flight(true)
 check(state()==original_state and game.page=="hub","hidden assembly and flight calls remain inert during inspection")
 game.render();step(.1)
 check(rig_pose()==frozen,"render cannot replace or advance inspected clerk pose")
 check(game.world.clerk.position==feet and game.page=="hub","held movement inside panel neither walks nor navigates")
 await key(KEY_TAB);await key(KEY_TAB,false);check(root.gui_get_focus_owner()==game.investigation._close,"Tab cannot escape the native modal focus")
 game._action("dispatch",null);check(game.page=="hub" and not game.hud.dispatch_confirmation_open,"underlying dispatch action is gated while examination is open")
 var trap:=Button.new();trap.position=Vector2(20,150);trap.size=Vector2(160,60);trap.text="Underlying";trap.pressed.connect(func():underlying_clicks+=1);game.hud.content.add_child(trap)
 await mouse(trap.get_global_rect().get_center(),true);await mouse(trap.get_global_rect().get_center(),false)
 check(underlying_clicks==0 and game.investigation.is_open(),"outside mouse click cannot reach an underlying native button")
 await key(KEY_ESCAPE);tick();check(not game.investigation.is_open() and input.context=="shop","Escape closes without changing shop page")
 check(root.gui_get_focus_owner()==null,"dismissal does not focus an underlying shop action")
 step(.4);check(game.world.clerk.position==feet and input.shop_axis()==0,"held D carried out of close remains quarantined")
 await key(KEY_E,true,true);check(not game.investigation.is_open(),"E held across open and Escape cannot reopen panel")
 await key(KEY_D,false);await key(KEY_ESCAPE,false);await key(KEY_E,false);await key(KEY_E)
 check(game.investigation.is_open(),"released then fresh E can re-examine without persistent flag")
 await key(KEY_E,false);await key(KEY_E);check(not game.investigation.is_open(),"fresh E also dismisses examination")
 await key(KEY_E);check(not game.investigation.is_open(),"duplicate close key cannot click through into another opening")
 await key(KEY_E,false);at_marble();await button(JOY_BUTTON_A);tick()
 check(game.investigation.is_open() and input.context=="investigation","controller A opens same optional panel")
 await button(JOY_BUTTON_A);check(game.investigation.is_open(),"held controller A cannot immediately close its own panel")
 await axis(.9);step(.25);check(game.world.clerk.position.x==Investigation.STATION_X,"held analog stick cannot move through modal")
 await button(JOY_BUTTON_B);tick();check(not game.investigation.is_open(),"controller back B dismisses panel")
 step(.25);check(input.shop_axis()==0 and game.world.clerk.position.x==Investigation.STATION_X,"held analog stick is quarantined after controller close")
 await button(JOY_BUTTON_A);check(not game.investigation.is_open(),"opening controller A remains blocked until physical release")
 await button(JOY_BUTTON_A,false);await button(JOY_BUTTON_B,false);await axis(0);await button(JOY_BUTTON_A)
 check(game.investigation.is_open(),"fresh controller A opens after release barrier")
 await button(JOY_BUTTON_A,false);await button(JOY_BUTTON_A);check(not game.investigation.is_open(),"fresh controller confirm closes exactly once")
 await button(JOY_BUTTON_A,false);await key(KEY_E);await key(KEY_E,false)
 var close_at:Vector2=game.investigation._close.get_global_rect().get_center()
 # Previous HUD trap was freed by render; use a fresh test-only native target.
 trap=Button.new();trap.size=Vector2(160,60);trap.pressed.connect(func():underlying_clicks+=1);game.hud.content.add_child(trap)
 # Align an underlying button directly with Close to exercise release click-through.
 trap.global_position=close_at-Vector2(80,30)
 await mouse(close_at,true);await mouse(close_at,false)
 check(not game.investigation.is_open() and underlying_clicks==0,"native mouse Close consumes its release without click-through")
 await key(KEY_E);await key(KEY_E,false);game._on_focus_exited();await key(KEY_ESCAPE)
 check(not game.investigation.is_open() and game.world._investigation_owner==0 and input.context=="inactive","focus loss closes panel and releases inspection owner")
 game._on_focus_entered();await key(KEY_ESCAPE,true,true);check(not game.investigation.is_open(),"focus return does not replay held Escape")
 await key(KEY_ESCAPE,false);await key(KEY_ESCAPE);await key(KEY_ESCAPE,false)
 check(not game.investigation.is_open(),"fresh Escape works after focus returns")
 await key(KEY_E);await key(KEY_E,false);await axis(.6);input._joy_connection_changed(0,false);tick()
 check(game.investigation.is_open() and input.active_device==-1,"disconnect preserves bounded panel and discards controller state")
 await key(KEY_ESCAPE);await key(KEY_ESCAPE,false)
 for size in [Vector2i(1280,800),Vector2i(1920,1080),Vector2i(3840,2160)]:
  root.size=size;await settle(3);at_marble();await key(KEY_E);await key(KEY_E,false)
  var snap:Dictionary=game.investigation.debug_snapshot()
  check(root.get_visible_rect().encloses(snap.panel_rect),"native panel remains wholly visible at "+str(size))
  check(game.investigation._body.get_line_count()<=3 and game.investigation._body.get_minimum_size().y<=game.investigation._body.size.y,"exact quote fits without clipped lines at "+str(size))
  await key(KEY_ESCAPE);await key(KEY_ESCAPE,false)
 root.size=Vector2i(1280,800);await settle(3);at_marble();await key(KEY_E);await key(KEY_E,false)
 game.navigate("workshop");tick();check(not game.investigation.is_open() and game.page=="workshop","page transition tears down optional panel")
 game._action(Investigation.ACTION,null);check(not game.investigation.is_open(),"workshop cannot invoke remote investigation")
 at_marble();game.hud.settings_open=true;game.hud.render(game.hud.state);tick();game._action(Investigation.ACTION,null)
 check(not game.investigation.is_open() and input.context=="modal","settings modal takes precedence over investigation")
 game.hud.settings_open=false;game.hud.render(game.hud.state);tick();await key(KEY_E);await key(KEY_E,false)
 game.dialogue.begin({"dialogue_id":"investigation-preempt","lines":[{"speaker":"npc","text":"测试。"}]},{},game.settings);await settle(3);tick()
 check(not game.investigation.is_open() and input.context=="dialogue","customer dialogue preempts optional panel cleanly")
 game.dialogue.cancel();await settle();tick();at_marble();await key(KEY_E);await key(KEY_E,false)
 game.world._parcel_phase="robot_fetch";game.world._loading_requested=true;game.world.active_id="fixture";game.world.parcel_state="loading";await settle(3);tick()
 check(not game.investigation.is_open() and input.context=="loading","loading cutscene preempts optional panel")
 game.world._parcel_phase="empty";game.world._loading_requested=false;game.world.active_id="";game.world.parcel_state="empty";tick();at_marble();game._pending_story={"contract_id":"pending","beat":"accept"};game._action(Investigation.ACTION,null)
 check(not game.investigation.is_open(),"pending story cannot be delayed by opening optional examination")
 game._pending_story.clear();tick();at_marble();await key(KEY_E);await key(KEY_E,false)
 game.hud.settings_open=true;game.hud.render(game.hud.state);await settle(3);tick()
 check(not game.investigation.is_open() and input.context=="modal","new native settings modal also preempts examination")
 game.hud.settings_open=false;game.hud.render(game.hud.state);tick();at_marble()
 check(state()==original_state and game.world.parcel.get_instance_id()==parcel_id and game.world._parcel_generation==generation,"all examinations preserve credits inventory story orders design and real parcel identity")
 trap=Button.new();trap.position=Vector2(20,150);trap.size=Vector2(160,60);trap.pressed.connect(func():underlying_clicks+=1);game.hud.content.add_child(trap)
 var trap_point:Vector2=trap.get_global_rect().get_center()
 await mouse(trap_point,true);await key(KEY_E);await key(KEY_E,false)
 check(game.investigation.is_open(),"fresh keyboard examination can open while an old mouse press is held")
 await key(KEY_ESCAPE);await key(KEY_ESCAPE,false);await mouse(trap_point,false)
 check(underlying_clicks==0,"mouse press held before opening cannot release through a keyboard-closed panel")
 await key(KEY_E);await key(KEY_E,false);await mouse(trap_point,true);await key(KEY_ESCAPE);await key(KEY_ESCAPE,false);await mouse(trap_point,false)
 check(underlying_clicks==0,"mouse held inside examination cannot release into shop after keyboard close")
 await mouse(trap_point,true);await mouse(trap_point,false)
 check(underlying_clicks==1,"released then fresh native mouse click remains usable after quarantine")
 trap.queue_free();await settle()
 # Both explicit owners reject the other at the same nearby station.
 at_marble();check(game._open_review_phone(),"phone still opens normally from nearby station")
 game._action(Investigation.ACTION,null)
 check(not game.investigation.begin() and not game.world.acquire_investigation(999) and game._review_phone_is_open(),"inspection cannot steal the open phone via action helper or world")
 game._close_review_phone();tick();await key(KEY_D);await axis(.9)
 game._action(Investigation.ACTION,null);await settle()
 var resize_feet:Vector2=game.world.clerk.position;var resize_rig:Dictionary=rig_pose()
 game._on_art_frame_changed(game.view_container.display_rect);step(.2)
 check(game.investigation.is_open() and rig_pose()==resize_rig,"resize preserves exact inspection pose and ownership")
 game.investigation.close();step(.2)
 check(game.world.clerk.position==resize_feet and input.shop_axis()==0,"resize then close quarantines held key and stick")
 await key(KEY_D,false);await axis(0);tick()
 var fixed_children:int=game.investigation.get_child_count();var fixed_widgets:int=game.investigation._canvas.get_child_count()
 for unused in 20:
  game._action(Investigation.ACTION,null);game.investigation.close()
 check(game.investigation.get_child_count()==fixed_children and game.investigation._canvas.get_child_count()==fixed_widgets and state()==original_state,"twenty repeat examinations reuse bounded native controls without saving or mutating state")
 game.world.night=true;game._action(Investigation.ACTION,null)
 check(game.investigation.is_open(),"stored prop remains optionally examinable at night")
 game.investigation.close();game.world.night=false
 var font:Font=game.investigation._body.get_theme_font("font");var supported:bool=true
 for c in EXACT+Investigation.TITLE+"查看关闭":supported=supported and font.has_char(c.unicode_at(0))
 check(supported,"bundled font explicitly contains every examination glyph")
 game._action(Investigation.ACTION,null);game._pending_story={"contract_id":"pending","beat":"accept"};await settle()
 check(not game.investigation.is_open() and game.world._investigation_owner==0,"new pending story preempts and releases investigation")
 game._pending_story.clear();at_marble();game._action(Investigation.ACTION,null);game.page="flight";await settle();tick()
 check(not game.investigation.is_open() and game.world._investigation_owner==0 and input.context=="flight","flight preempts and releases investigation")
 game.page="hub";at_marble();game.world.clerk.position=Vector2(276,486);game.world._adopt_shop_clerk();tick()
 check(input._hint.text in ["E 前台","A 前台"],"leaving storage area removes examination prompt")
 game.world.clerk.position=Vector2(game.world.assembly_origin.x,496);game.world._adopt_shop_clerk();tick()
 check(game.world.shop_interaction().get("id","")=="focus_workbench","optional prop never steals the authored workbench interaction")
 game.world.clerk.position=Vector2(Investigation.STATION_X+Investigation.STATION_RADIUS+2,496);game.world._adopt_shop_clerk();tick()
 check(not input._hint.text.contains("弹珠"),"examination prompt disappears immediately outside its bounded radius")
 at_marble();check(game.investigation.begin(),"inspection opens before panel teardown")
 var removed=game.investigation;game.remove_child(removed);removed.queue_free();await settle()
 check(game.world._investigation_owner==0 and input.desired_context()=="shop","panel teardown releases matching world owner and router")
 game.queue_free();await settle(5)
 game=load("res://scenes/main.tscn").instantiate();root.add_child(game);game.set_process(false);await settle(4)
 input=game.courier_input;game.world.set_process(false);at_marble();game.investigation.begin();game.queue_free();await settle(5)
 check(not is_instance_valid(game),"root teardown with open investigation releases cleanly")
 print("SHOP_INVESTIGATION passed=%d failed=%d input=synthetic_InputEvent physical_gamepad=false GPU_visual=false"%[passed,failed]);quit(1 if failed else 0)
